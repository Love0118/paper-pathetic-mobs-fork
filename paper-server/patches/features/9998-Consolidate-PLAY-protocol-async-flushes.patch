+public class Varint21LengthFieldPrepender extends MessageToMessageEncoder<ByteBuf> {
     public static final int MAX_VARINT21_BYTES = 3;
+    private final boolean prependInPlace;
+
+    public Varint21LengthFieldPrepender() {
+        this(prependInPlaceEnabled());
+    }
+
+    public Varint21LengthFieldPrepender(final boolean prependInPlace) {
+        this.prependInPlace = prependInPlace;
+    }
+
+    private static boolean prependInPlaceEnabled() {
+        final io.papermc.paper.configuration.GlobalConfiguration configuration =
+            io.papermc.paper.configuration.GlobalConfiguration.get();
+        return configuration != null && configuration.optimizations.networkFramePrefixInPlace.enabled;
+    }

     @Override
-    protected void encode(final ChannelHandlerContext ctx, final ByteBuf msg, final ByteBuf out) {
+    protected void encode(final ChannelHandlerContext ctx, final ByteBuf msg, final List<Object> out) {
         int bodyLength = msg.readableBytes();
         int headerLength = VarInt.getByteSize(bodyLength);
         if (headerLength > 3) {
             throw new EncoderException("Packet too large: size " + bodyLength + " is over 8");
         }

-        out.ensureWritable(headerLength + bodyLength);
-        VarInt.write(out, bodyLength);
-        out.writeBytes(msg, msg.readerIndex(), bodyLength);
+        if (this.canPrependInPlace(msg)) {
+            final int headerIndex = msg.readerIndex() - headerLength;
+            writeVarInt(msg, headerIndex, bodyLength);
+            msg.readerIndex(headerIndex);
+            io.papermc.paper.optimization.MobOptRuntimeMetrics.framePrefixInPlace(bodyLength);
+            out.add(msg.retain());
+            return;
+        }
+
+        final ByteBuf framed = ctx.alloc().ioBuffer(headerLength + bodyLength);
+        try {
+            VarInt.write(framed, bodyLength);
+            framed.writeBytes(msg, msg.readerIndex(), bodyLength);
+            io.papermc.paper.optimization.MobOptRuntimeMetrics.framePrefixFallback(this.prependInPlace, bodyLength);
+            out.add(framed);
+        } catch (final RuntimeException | Error throwable) {
+            framed.release();
+            throw throwable;
+        }
+    }
+
+    private boolean canPrependInPlace(final ByteBuf msg) {
+        return this.prependInPlace
+            && msg.readerIndex() >= MAX_VARINT21_BYTES
+            && msg.refCnt() == 1
+            && msg.unwrap() == null
+            && !(msg instanceof io.netty.buffer.CompositeByteBuf)
+            && msg.nioBufferCount() == 1
+            && !msg.isReadOnly();
+    }
+
+    private static void writeVarInt(final ByteBuf target, int index, int value) {
+        while ((value & -128) != 0) {
+            target.setByte(index++, value & 127 | 128);
+            value >>>= 7;
+        }
+        target.setByte(index, value);
     }
