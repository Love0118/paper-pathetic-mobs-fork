+    @SuppressWarnings("unchecked")
+    private void doSendEffectBundle(final java.util.List<io.papermc.paper.optimization.zvs.network.ZvsPlayWriteQueue.Entry> entries, final boolean flush) {
+        if (!this.isConnected()) {
+            for (final io.papermc.paper.optimization.zvs.network.ZvsPlayWriteQueue.Entry entry : entries) {
+                final ZvsQueuedPacket queued = (ZvsQueuedPacket)entry.payload();
+                queued.packet().onPacketDispatchFinish(queued.player(), null);
+            }
+            return;
+        }
+
+        final java.util.List<Packet<? super net.minecraft.network.protocol.game.ClientGamePacketListener>> packets = new java.util.ArrayList<>(entries.size());
+        boolean needsFuture = false;
+        for (final io.papermc.paper.optimization.zvs.network.ZvsPlayWriteQueue.Entry entry : entries) {
+            final ZvsQueuedPacket queued = (ZvsQueuedPacket)entry.payload();
+            packets.add((Packet<? super net.minecraft.network.protocol.game.ClientGamePacketListener>)queued.packet());
+            needsFuture |= queued.listener() != null || queued.packet().hasFinishListener();
+        }
+
+        try {
+            final net.minecraft.network.protocol.game.ClientboundBundlePacket bundle = new net.minecraft.network.protocol.game.ClientboundBundlePacket(packets);
+            final ChannelFuture future;
+            if (needsFuture) {
+                future = flush ? this.channel.writeAndFlush(bundle) : this.channel.write(bundle);
+            } else if (flush) {
+                future = this.channel.writeAndFlush(bundle, this.channel.voidPromise());
+            } else {
+                future = this.channel.write(bundle, this.channel.voidPromise());
+            }
+            if (needsFuture) {
+                for (final io.papermc.paper.optimization.zvs.network.ZvsPlayWriteQueue.Entry entry : entries) {
+                    final ZvsQueuedPacket queued = (ZvsQueuedPacket)entry.payload();
+                    if (queued.listener() != null) {
+                        future.addListener(queued.listener());
+                    }
+                    if (queued.packet().hasFinishListener()) {
+                        future.addListener((ChannelFutureListener)completed -> queued.packet().onPacketDispatchFinish(queued.player(), completed));
+                    }
+                }
+            }
+        } catch (final Exception exception) {
+            LOGGER.error("NetworkException while writing ZVS effect bundle", exception);
+            for (final io.papermc.paper.optimization.zvs.network.ZvsPlayWriteQueue.Entry entry : entries) {
+                final ZvsQueuedPacket queued = (ZvsQueuedPacket)entry.payload();
+                queued.packet().onPacketDispatchFinish(queued.player(), null);
+            }
+            final Component reason = Component.translatable("disconnect.genericReason", "Internal Exception: " + exception.getMessage());
+            this.send(new ClientboundDisconnectPacket(reason), PacketSendListener.thenRun(() -> this.disconnect(reason)));
+        }
+    }
+
+    private record ZvsQueuedPacket(Packet<?> packet, @Nullable ChannelFutureListener listener, net.minecraft.server.level.@Nullable ServerPlayer player) {
+    }
