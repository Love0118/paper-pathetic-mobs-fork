-                    connection.send(packet);
+                final ServerPlayer player = connection.getPlayer();
+                if (targetPredicate.test(player)) {
+                    final Packet<? super ClientGamePacketListener> lodPacket = zvsNetworkLod.packetFor(preparedPacket, player);
