+    private long doSendPacketMeasured(final Packet<?> packet, final @Nullable ChannelFutureListener listener, final boolean flush) {
+        final io.netty.channel.ChannelOutboundBuffer outboundBuffer = this.channel.unsafe().outboundBuffer();
+        final long before = outboundBuffer == null ? 0L : outboundBuffer.totalPendingWriteBytes();
+        this.doSendPacket(packet, listener, false);
+        final long written = outboundBuffer == null ? 0L : Math.max(0L, outboundBuffer.totalPendingWriteBytes() - before);
+        if (flush) {
+            this.channel.flush();
+        }
+        if (outboundBuffer == null) {
+            return 0L;
+        }
+        return written;
+    }
