-            VarInt.write(decoder, i);
-            decoder.writeBytes(encoder, encoder.readerIndex(), i);
+    protected void encode(ChannelHandlerContext context, ByteBuf message, List<Object> out) {
+        final int bodyLength = message.readableBytes();
+        final int headerLength = VarInt.getByteSize(bodyLength);
+        if (headerLength > MAX_VARINT21_BYTES) {
+            throw new EncoderException("Packet too large: size " + bodyLength + " is over 8");
+        }
+
+        if (this.canPrependInPlace(message)) {
+            final int headerIndex = message.readerIndex() - headerLength;
+            writeVarInt(message, headerIndex, bodyLength);
+            message.readerIndex(headerIndex);
+            io.papermc.paper.optimization.MobOptRuntimeMetrics.framePrefixInPlace(bodyLength);
+            out.add(message.retain());
+            return;
+        }
+
+        final ByteBuf framed = context.alloc().ioBuffer(headerLength + bodyLength);
+        try {
+            VarInt.write(framed, bodyLength);
+            framed.writeBytes(message, message.readerIndex(), bodyLength);
+            io.papermc.paper.optimization.MobOptRuntimeMetrics.framePrefixFallback(this.prependInPlace, bodyLength);
+            out.add(framed);
+        } catch (final RuntimeException | Error throwable) {
+            framed.release();
+            throw throwable;
+        }
+    }
+
+    private boolean canPrependInPlace(ByteBuf message) {
+        return this.prependInPlace
+            && message.readerIndex() >= MAX_VARINT21_BYTES
+            && message.refCnt() == 1
+            && message.unwrap() == null
+            && !(message instanceof io.netty.buffer.CompositeByteBuf)
+            && message.nioBufferCount() == 1
+            && !message.isReadOnly();
+    }
+
+    private static void writeVarInt(ByteBuf target, int index, int value) {
+        while ((value & -128) != 0) {
+            target.setByte(index++, value & 127 | 128);
+            value >>>= 7;
         }
+        target.setByte(index, value);
     }
