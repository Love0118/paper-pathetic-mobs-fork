diff --git a/net/minecraft/network/Varint21LengthFieldPrepender.java b/net/minecraft/network/Varint21LengthFieldPrepender.java
index a3f3684a6f00cd0238c5f6122d449814700eab60..9e5fc8da1a9caa9ae4cd528476c6722bff18864c 100644
--- a/net/minecraft/network/Varint21LengthFieldPrepender.java
+++ b/net/minecraft/network/Varint21LengthFieldPrepender.java
@@ -4,22 +4,70 @@ import io.netty.buffer.ByteBuf;
 import io.netty.channel.ChannelHandlerContext;
 import io.netty.channel.ChannelHandler.Sharable;
 import io.netty.handler.codec.EncoderException;
-import io.netty.handler.codec.MessageToByteEncoder;
+import io.netty.handler.codec.MessageToMessageEncoder;
+import java.util.List;
 
 @Sharable
-public class Varint21LengthFieldPrepender extends MessageToByteEncoder<ByteBuf> {
+public class Varint21LengthFieldPrepender extends MessageToMessageEncoder<ByteBuf> {
     public static final int MAX_VARINT21_BYTES = 3;
+    private final boolean mudInPlacePrefix;
+
+    public Varint21LengthFieldPrepender() {
+        this(mudInPlacePrefixEnabled());
+    }
+
+    public Varint21LengthFieldPrepender(final boolean inPlacePrefix) {
+        this.mudInPlacePrefix = inPlacePrefix;
+    }
+
+    private static boolean mudInPlacePrefixEnabled() {
+        final io.papermc.paper.configuration.GlobalConfiguration configuration = io.papermc.paper.configuration.GlobalConfiguration.get();
+        return configuration != null && configuration.mudOptimizations.inPlaceFramePrefix;
+    }
 
     @Override
-    protected void encode(final ChannelHandlerContext ctx, final ByteBuf msg, final ByteBuf out) {
+    protected void encode(final ChannelHandlerContext ctx, final ByteBuf msg, final List<Object> out) {
         int bodyLength = msg.readableBytes();
         int headerLength = VarInt.getByteSize(bodyLength);
         if (headerLength > 3) {
             throw new EncoderException("Packet too large: size " + bodyLength + " is over 8");
         }
 
-        out.ensureWritable(headerLength + bodyLength);
-        VarInt.write(out, bodyLength);
-        out.writeBytes(msg, msg.readerIndex(), bodyLength);
+        if (this.canPrefixInPlace(msg, headerLength)) {
+            final int prefixIndex = msg.readerIndex() - headerLength;
+            writeVarIntAt(msg, prefixIndex, bodyLength);
+            msg.readerIndex(prefixIndex);
+            out.add(msg.retain());
+            return;
+        }
+
+        final ByteBuf framed = ctx.alloc().ioBuffer(headerLength + bodyLength);
+        try {
+            VarInt.write(framed, bodyLength);
+            framed.writeBytes(msg, msg.readerIndex(), bodyLength);
+            out.add(framed);
+        } catch (final RuntimeException | Error throwable) {
+            framed.release();
+            throw throwable;
+        }
+    }
+
+    private boolean canPrefixInPlace(final ByteBuf buffer, final int headerLength) {
+        return this.mudInPlacePrefix
+            && buffer.readerIndex() >= headerLength
+            && buffer.readerIndex() >= MAX_VARINT21_BYTES
+            && buffer.refCnt() == 1
+            && buffer.unwrap() == null
+            && !(buffer instanceof io.netty.buffer.CompositeByteBuf)
+            && buffer.nioBufferCount() == 1
+            && !buffer.isReadOnly();
+    }
+
+    private static void writeVarIntAt(final ByteBuf buffer, int index, int value) {
+        while ((value & -128) != 0) {
+            buffer.setByte(index++, value & 127 | 128);
+            value >>>= 7;
+        }
+        buffer.setByte(index, value);
     }
 }
